<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BusinessPortal.Domain</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Project-wide usings so entity files don't repeat them (Asictron convention). -->
  <ItemGroup>
    <Using Include="BusinessPortal.Domain.Common" />
    <Using Include="BusinessPortal.Domain.Entities" />
    <Using Include="BusinessPortal.Domain.Enums" />
  </ItemGroup>

</Project>
