<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessPortal.Domain\BusinessPortal.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <!-- Abstractions only — the concrete DbContext lives in Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
  </ItemGroup>

  <!-- Project-wide usings (Asictron convention). -->
  <ItemGroup>
    <Using Include="BusinessPortal.Domain.Entities" />
    <Using Include="BusinessPortal.Domain.Enums" />
  </ItemGroup>

</Project>
